# Clipora Master Environment Configuration Example
# Copy to .env or configure via Web Dashboard Settings (/settings)

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_JOBS=2

# AI Services
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Transcription Preferences
# Options: deepgram | elevenlabs | whisper
TRANSCRIPTION_PROVIDER=deepgram
AUDIO_ISOLATION=false

# Reframe Preferences
# Options: auto | subject | disabled
REFRAME_MODE=auto
REFRAME_STATIC_AUTO=1

# Publishing Integration (Zernio)
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://api.zernio.com
ZERNIO_MIN_GAP_SECONDS=5400

# Live Monitoring Credentials
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
